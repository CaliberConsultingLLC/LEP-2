rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUid(uid) {
      return isSignedIn() && uid is string && uid == request.auth.uid;
    }

    // The server has no service account — key creation is blocked by org
    // policy — so it signs in as one ordinary account and acts as that. The
    // Admin SDK used to bypass these rules entirely; the robot does not, so
    // everything the server does has to be allowed here explicitly.
    function isRobot() {
      return isSignedIn() && request.auth.uid == 'TVPZiQah9uPI8ycO4umeEePHJU12';
    }

    // Once an intake is locked, the answers stop being editable — and that has
    // to hold here, not just in the UI. Hiding the Edit buttons only stops
    // someone who is not looking at the console.
    function intakeIsLocked() {
      return resource != null
        && 'intakeLock' in resource.data
        && resource.data.intakeLock.locked == true;
    }

    // The write is only rejected if it would actually change a locked answer.
    // Everything else on the doc — billing, campaignBundle, the lock stamp
    // itself — stays writable, so locking does not freeze the whole record.
    function touchesLockedAnswers() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['intakeDraft', 'latestFormData']);
    }

    match /responses/{docId} {
      allow create, get: if isOwnerUid(docId) || isRobot();
      // The robot writes billing and campaignMail, never answers, so the lock
      // still binds it exactly as it binds the owner.
      allow update: if (isOwnerUid(docId) || isRobot())
        && !(intakeIsLocked() && touchesLockedAnswers());
      // Only the robot may scan across leaders: that is the nightly mail and
      // the admin console, and no signed-in customer has any business here.
      allow list: if isRobot();
      allow delete: if false;
    }

    match /societalNorms/{docId} {
      allow create, get, update: if isSignedIn();
      allow list, delete: if false;
    }

    match /campaigns/{docId} {
      allow create, update: if isSignedIn();
      allow get: if isSignedIn();
      allow list: if isRobot();
      allow delete: if false;
    }

    match /surveyResponses/{docId} {
      allow create: if isSignedIn();
      allow get, update: if isSignedIn();
      allow list: if isSignedIn();
      allow delete: if false;
    }

    match /users/{docId} {
      allow create, get, update: if isSignedIn();
      allow list: if isRobot();
      allow delete: if false;
    }

    // Never had a rule, so the catch-all denied it. That went unnoticed only
    // because the Admin SDK ignored rules; under the robot it would have been
    // the first thing to break.
    match /authEvents/{docId} {
      allow create: if isSignedIn();
      allow get, list: if isRobot();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
