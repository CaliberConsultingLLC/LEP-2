VITE_ENABLE_DEV_TOOLS=false
VITE_ENABLE_DEV_BYPASS=false
VITE_DASHBOARD_DATA_SOURCE=fake

# Staging-only escape hatches, split out of the Cairn theme flag so the new
# design can ship without also shipping an open dashboard. Both default to on
# for the staging host and are always off on the production host.
# Set both to false on staging to rehearse production: real login, real
# Firestore writes, real signed campaign tokens.
VITE_ALLOW_AUTH_BYPASS=
VITE_ALLOW_PERSISTENCE_BYPASS=

# The Cairn design renders on every host by default. Set this to true (or add
# ?theme=legacy to any URL) to fall back to the old pre-redesign skin.
VITE_LEGACY_SKIN=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_APP_BASE_URL=
VITE_APP_SIGN_IN_URL=
# Optional: Organization "Talk to us" CTA on staging landing
VITE_CALENDLY_URL=

# Stripe Payment Link used by /pay (account creation -> payment -> guide).
# Leave blank to use the test link baked into src/utils/billing.js; set the
# live link here before taking real money; set to "off" to skip payment.
VITE_STRIPE_PAYMENT_LINK=

# Server-side email placeholders (configure in Vercel project env vars)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
FIREBASE_WEB_API_KEY=
APP_BASE_URL=
APP_SIGN_IN_URL=
APP_FORGOT_PASSWORD_URL=
