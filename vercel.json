{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://firestore.googleapis.com https://*.googleapis.com https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/get-ai-summary",
      "destination": "/api/get-ai-summary.js"
    },
    {
      "source": "/get-ai-reflection",
      "destination": "/api/get-ai-reflection.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/get-ai-summary.js": {
      "maxDuration": 300
    },
    "api/get-ai-reflection.js": {
      "maxDuration": 60
    },
    "api/get-agent-insight.js": {
      "maxDuration": 30
    },
    "api/send-welcome-email.js": {
      "maxDuration": 30
    },
    "api/get-campaign.js": {
      "maxDuration": 60
    },
    "api/create-checkout-session.js": {
      "maxDuration": 30
    },
    "api/confirm-checkout.js": {
      "maxDuration": 30
    },
    "api/repository-login.js": {
      "maxDuration": 30
    },
    "api/get-repository-data.js": {
      "maxDuration": 30
    },
    "api/get-results-analysis.js": {
      "maxDuration": 300
    },
    "api/get-guide-lines.js": {
      "maxDuration": 300
    },
    "api/regenerate-statement.js": {
      "maxDuration": 60
    }
  }
}
